{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "minimax",
      "options": {
        "baseURL": "https://minimax.io"
      },
      "models": {
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7"
        }
      }
    },
    "github Copilot": {
      "npm": "@ai-sdk/github-copilot",
      "name": "github Copilot",
      "options": {
        "baseURL": "https://api.github.com"
      },
      "models": {
        "github Copilot": {
          "name": "github Copilot"
        }
      }
    }
  }
}
