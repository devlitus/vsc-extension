{
  "name": "pixel-agents",
  "version": "0.0.1",
  "description": "Pixel Agents - Visual Claude Code agent tracker",
  "publisher": "pixel-agents",
  "engines": {
    "vscode": "^1.105.0"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "files": [
    "dist/",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pixel-agents.showPanel",
        "title": "Show Pixel Agents Panel"
      },
      {
        "command": "pixel-agents.exportDefaultLayout",
        "title": "Export Default Layout"
      }
    ],
    "views": {
      "activitybar": [
        {
          "id": "pixel-agents",
          "name": "Pixel Agents"
        }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.105.0",
    "@vitest/ui": "^1.0.0",
    "playwright": "^1.40.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "build:ext": "bun build src/extension.ts --target=node --format=cjs --outfile=dist/extension.js --external vscode",
    "build:webview": "bun build webview-ui/src/main.tsx --outfile=dist/webview/main.js --minify",
    "build": "bun run build:ext && bun run build:webview",
    "watch": "bun run build:ext --watch & bun run build:webview --watch",
    "test:webview": "vitest run --config webview-ui/vitest.config.ts webview-ui/test",
    "test:server": "vitest run --config server/vitest.config.ts server/__tests__",
    "test:e2e": "playwright test",
    "test": "bun run test:webview && bun run test:server",
    "package": "vsce package"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
